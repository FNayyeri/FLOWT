{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/flowt/venv/bin/streamlit",
            "args": [
                "run",
                "app.py",
                "--server.runOnSave", "true"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug Any Page",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/flowt/venv/bin/python",
            "module": "streamlit",
            "args": [
                "run",
                "${input:pagePath}",
                "--server.runOnSave", "true"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/flowt"
        }
    ],
    "inputs": [
        {
            "id": "pagePath",
            "description": "Select page to debug",
            "type": "pickString",
            "options": [
                "pages/1_📁_Data_Ingestion.py",
                "pages/2_🔍_Inference.py",
                "pages/3_✏️_Curation.py",
                "pages/4_🎯_Tracking.py",
                "pages/5_🎬_Video_Generation.py",
                "pages/6_📊_Analysis.py",
                "pages/7_🤖_Analysis_AI.py",
                "pages/8_🔧_Fine_Tuning.py"
            ]
        }
    ]
}